# Copy to .env for Docker Compose, or export the variables in your shell.
# Use a unique random value with at least 32 UTF-8 bytes. Never commit the real .env.
TOKEN_SECRET=
AGENT_INTERNAL_TOKEN=
AI_AGENT_MAX_ATTEMPTS=3
# Each research task chooses offline-demo or deepseek-tools. This is only the Agent health default.
AGENT_PROVIDER=offline-demo
# The key stays inside the Agent container and is never returned to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Leave blank to use 8080 and let the start script fall back to 18080 when occupied.
GATEWAY_HOST_PORT=
# Leave blank so the start script derives it from the selected Gateway host port.
PUBLIC_GATEWAY_URL=
# Local demo accepts file:// and any localhost origin. Restrict this pattern in shared deployments.
GATEWAY_ALLOWED_ORIGIN_PATTERN=*
TOKEN_EXPIRE_SECONDS=86400
# Enable only when requests can reach the app exclusively through a trusted reverse proxy.
TRUST_FORWARDED_HEADERS=false
# 混合模式使用 broker-host.conf；scripts/start-docker.ps1 会自动切换为 broker-docker.conf。
ROCKETMQ_BROKER_CONFIG=broker-host.conf
# Docker Hub 不可达时可设置为 m.daocloud.io/docker.io/library。
DOCKER_BASE_REGISTRY=docker.io/library
