# PowerShell uses $env:NAME='value'; Java does not automatically load this file.
# H2 demo needs no database variables. For MySQL/MariaDB use a dedicated database.
DB_URL=jdbc:mysql://127.0.0.1:3306/xplanet_booking?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USER=booking
DB_PASSWORD=replace-with-database-password
ADMIN_PASSWORD=replace-with-a-strong-admin-password
PORT=8080
