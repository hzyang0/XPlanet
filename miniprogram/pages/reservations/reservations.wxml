<view class="page"><view class="title">预约记录</view><view class="muted">普通用户查看本人记录；管理员账号按后端权限查看全部记录。审批和设备管理请使用网页管理端。</view><button bindtap="refresh" loading="{{busy}}">刷新状态</button><view class="error">{{error}}</view><view class="card" wx:for="{{items}}" wx:key="id"><view>#{{item.id}} · 设备 #{{item.equipmentId}}</view><view class="status">{{item.label}}</view><view>{{item.period}}</view><view>{{item.purpose}}</view><view wx:if="{{item.deadlineText}}">确认／审批截止：{{item.deadlineText}}</view><button wx:if="{{item.status==='OFFERED'}}" data-id="{{item.id}}" data-action="accept" bindtap="action" disabled="{{busy}}">确认补位</button><button wx:if="{{item.status==='CONFIRMED'}}" data-id="{{item.id}}" data-action="check-in" bindtap="action" disabled="{{busy}}">签到</button><button wx:if="{{item.status==='CONFIRMED'}}" data-id="{{item.id}}" data-equipment="{{item.equipmentId}}" bindtap="reschedule">改期</button><button wx:if="{{item.status==='IN_USE'}}" data-id="{{item.id}}" data-action="finish" bindtap="action" disabled="{{busy}}">结束使用</button><button wx:if="{{item.cancelable}}" data-id="{{item.id}}" data-action="cancel" bindtap="action" disabled="{{busy}}">取消</button></view><view wx:if="{{!items.length}}">暂无预约</view><button wx:if="{{more}}" bindtap="next">加载更多</button></view>
