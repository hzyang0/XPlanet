<view class="page"><view class="title">查找实验设备</view><input value="{{q}}" bindinput="input" placeholder="设备、分类或位置" maxlength="100"/><button bindtap="search" loading="{{busy}}">搜索／刷新</button><view class="error">{{error}}</view><view class="card" wx:for="{{items}}" wx:key="id"><view class="title">{{item.name}}</view><view>{{item.location}} · {{item.category}}</view><view class="muted">{{item.description}}</view><view>审批：{{item.approvalRequired?'需要':'不需要'}} · 培训：{{item.trainingRequired?'需要':'不需要'}}</view><button type="primary" disabled="{{!item.enabled}}" data-id="{{item.id}}" bindtap="book">{{item.enabled?'查看时段与预约':'已停用'}}</button></view><view wx:if="{{!items.length}}">暂无设备</view><button wx:if="{{more}}" bindtap="next">加载更多</button><button bindtap="logout">退出登录／切换服务</button></view>
